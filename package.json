{
  "name": "cursor-to-dsh",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin: Cursor models + Settings UI for multi API keys and optional webSearch/webFetch (session /cursor-web)",
  "author": "AngusFu (fork of lukeinx/cursor-to-dsh)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngusFu/cursor-to-dsh.git"
  },
  "homepage": "https://github.com/AngusFu/cursor-to-dsh#readme",
  "bugs": {
    "url": "https://github.com/AngusFu/cursor-to-dsh/issues"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-desktop",
    "cursor",
    "cursor-sdk",
    "llm-provider",
    "deepseek",
    "dsh",
    "ai-agent",
    "claude",
    "gpt",
    "gemini"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client",
    "cordis.patch.yml",
    "tsconfig.build.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-client.mjs",
    "prepare": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "tsc --noEmit",
    "check:public": "node scripts/check-public.mjs",
    "prepublishOnly": "npm run check && npm test && npm run build && npm run check:public"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.37"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2"
  }
}
